logs/
models/

# Claude Code: локальные настройки (общий settings.json — коммитится)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# IDE и редакторы
.vscode/
.idea/
*.swp

# Windows
Thumbs.db
desktop.ini
